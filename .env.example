# POI Yönetim Sistemi - Çevre Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin

# Veritabanı Bağlantı Bilgileri
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poi_database
DB_USER=poi_user
DB_PASSWORD=your_secure_password_here

# API Ayarları
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Yedekleme Ayarları
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily

# Medya Dosya Ayarları
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp
THUMBNAIL_SIZE=300x300

# Güvenlik Ayarları
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# Kimlik Doğrulama / Yetkilendirme
# Admin işlemleri: tek paylaşımlı token (min 16 karakter önerilir)
POI_ADMIN_TOKEN=change_me_to_a_long_random_token
# Flask SECRET_KEY fallback (cookie imzalama vs.)
POI_SESSION_SECRET_KEY=your_session_secret_key_here

# Log Ayarları
LOG_LEVEL=INFO
LOG_FILE=poi_system.log
