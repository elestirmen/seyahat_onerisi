# Environment configuration template
# Copy this file to .env and fill in your specific values.

# Database configuration (modular app reads DB_* first)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poi_db
DB_USER=poi_user
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10
DB_TIMEOUT=30

# Legacy script compatibility (many scripts use POI_DB_*)
POI_DB_TYPE=postgresql
POI_DB_HOST=localhost
POI_DB_PORT=5432
POI_DB_NAME=poi_db
POI_DB_USER=poi_user
POI_DB_PASSWORD=your_db_password
POI_DB_CONNECTION=postgresql://poi_user:your_db_password@localhost/poi_db
# Development-only escape hatch. Keep false in production to prevent workers
# from writing to different stores after a transient database failure.
POI_ENABLE_JSON_FALLBACK=false

# Flask/Application configuration
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5560
SECRET_KEY=your_secret_key_here_minimum_32_characters
POI_SESSION_SECRET_KEY=your_session_secret_key_here_minimum_32_characters

# Authentication (admin token, min 16 chars)
POI_ADMIN_TOKEN=your_random_long_token_min_16_chars

# CORS and rate limiting
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_ATTEMPT_WINDOW_SECONDS=900
# Comma-separated trusted reverse proxy addresses/CIDRs; never use * publicly.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# File upload/media
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=temp_uploads
POI_MEDIA_FOLDER=poi_media
ROUTE_IMPORT_STATE_TTL_SECONDS=86400

# Performance and logging
ENABLE_CACHING=true
CACHE_TIMEOUT=300
LOG_LEVEL=INFO
LOG_FILE=api.log

# Testing
TEST_MODE=false
API_BASE_URL=http://localhost:5000
